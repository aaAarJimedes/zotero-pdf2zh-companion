{
  "manifest_version": 2,
  "name": "PDF2zh 本地伴侣",
  "version": "2.0.0",
  "description": "一个按钮：启动本地 PDF2zh Server，并在 Zotero 内打开服务页面。翻译由 PDF2zh 接管。",
  "author": "aaAarJimedes",
  "homepage_url": "https://github.com/aaAarJimedes/zotero-pdf2zh-companion",
  "icons": {
    "48": "content/icons/server.svg",
    "96": "content/icons/server.svg"
  },
  "applications": {
    "zotero": {
      "id": "pdf2zh-companion@local",
      "update_url": "https://github.com/aaAarJimedes/zotero-pdf2zh-companion/releases/latest/download/updates.json",
      "strict_min_version": "9.0",
      "strict_max_version": "10.*"
    }
  }
}
