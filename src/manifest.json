{
  "manifest_version": 2,
  "name": "PDF2zh 本地伴侣",
  "version": "1.2.1",
  "description": "为 Zotero PDF2zh 自动启动本机 Conda Server，并以两个独立阅读器左右对照原文与译文。",
  "author": "aaAarJimedes",
  "homepage_url": "https://github.com/aaAarJimedes/zotero-pdf2zh-companion",
  "icons": {
    "48": "content/icons/translate.svg",
    "96": "content/icons/translate.svg"
  },
  "applications": {
    "zotero": {
      "id": "pdf2zh-companion@local",
      "strict_min_version": "9.0",
      "strict_max_version": "10.*"
    }
  }
}
